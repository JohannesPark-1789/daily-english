# 카카오 개발자 앱 정보 — 이 파일을 .env 로 복사해서 값을 채운다.
# .env 는 절대 커밋하지 않는다 (_shared/CONVENTIONS.md §2).

# 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=

# 카카오 로그인 > Redirect URI 에 등록한 값과 정확히 같아야 한다.
KAKAO_REDIRECT_URI=http://localhost:8910/callback

# 선택 — 카카오 로그인 > 보안 에서 Client Secret 을 "사용" 으로 켠 경우에만 필요하다.
# (켜져 있는데 비워 두면 토큰 발급이 KOE010 / Bad client credentials 로 실패한다)
KAKAO_CLIENT_SECRET=
